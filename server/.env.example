# DB
PORT=3000
DB_HOST=your_database_host
DB_PORT=your_database_port
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=your_database_name

# JWT
JWT_SECRET=your_jwt_secret

# Cache for currency conversion rates, in seconds. Default: 3600 (1 hour)
CURRENCY_CACHE_SECONDS=3600

# API key for the supplier products API. 
SUPPLIER_API_KEY=your_supplier_api_key

# Algolia: dashboard.algolia.com → Settings → API Keys
ALGOLIA_APP_ID=
# Admin API Key: may WRITE to the index. Secret – only on the server, never in React or in git.
ALGOLIA_ADMIN_KEY=
# Search API Key: may only search.
ALGOLIA_SEARCH_KEY=
# Its own index, so the walkthrough doesn't overwrite the index your shop uses.
ALGOLIA_INDEX=walkthrough_products


# Stripe: dashboard.stripe.com → Developers → API keys (test mode)
# Secret key: may create payments. Secret – only on the server, never in React or in git.
STRIPE_SECRET_KEY=
# Webhook signing secret: needed as soon as the server RECEIVES webhooks – locally too.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the customer back after paying (the React app)
CLIENT_URL=http://localhost:5173


# Supabase: supabase.com/dashboard → your project id → Settings → General
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase: supabase.com/dashboard → your project → Settings → API Keys
SUPABASE_SECRET_KEY=sb_secret_
# The bucket you created in Storage
SUPABASE_BUCKET=product-images