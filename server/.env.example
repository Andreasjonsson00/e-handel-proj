# DB
PORT=3000
DB_HOST=your_database_host
DB_PORT=your_database_port
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=your_database_name

# JWT
JWT_SECRET=your_jwt_secret

# Cache for currency conversion rates, in seconds. Default: 3600 (1 hour)
CURRENCY_CACHE_SECONDS=3600

# API key for the supplier products API. 
SUPPLIER_API_KEY=your_supplier_api_key

# Algolia: dashboard.algolia.com → Settings → API Keys
ALGOLIA_APP_ID=
# Admin API Key: may WRITE to the index. Secret – only on the server, never in React or in git.
ALGOLIA_ADMIN_KEY=
# Search API Key: may only search.
ALGOLIA_SEARCH_KEY=
# Its own index, so the walkthrough doesn't overwrite the index your shop uses.
ALGOLIA_INDEX=walkthrough_products


# Stripe: dashboard.stripe.com → Developers → API keys (test mode)
# Secret key: may create payments. Secret – only on the server, never in React or in git.
STRIPE_SECRET_KEY=
# Webhook signing secret: needed as soon as the server RECEIVES webhooks – locally too.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the customer back after paying (the React app)
CLIENT_URL=http://localhost:5173


# Supabase: supabase.com/dashboard → your project id → Settings → General
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase: supabase.com/dashboard → your project → Settings → API Keys
SUPABASE_SECRET_KEY=sb_secret_
# The bucket you created in Storage
SUPABASE_BUCKET=product-images

# Postnord: https://developer.postnord.com/
POSTNORD_API_KEY=your_postnord_api_key
# Avsändarens svenska postnummer för Transit Time Calculation V2.
POSTNORD_ORIGIN_POSTAL_CODE=11120


# Google Cloud Console → https://console.cloud.google.com
#   1. Create a project
#   2. APIs & Services → OAuth consent screen → Get started: app name, your e-mail, Audience "External".
#      Audience, Branding and Data Access need nothing more for a login.
#   3. Clients → Create client → Web application
#        Authorized redirect URIs: http://localhost:5173/api/auth/google/callback (must match GOOGLE_CALLBACK_URL exactly)
#   4. Copy the Client ID and the Client secret at once – the secret is only shown when the client is created.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# The shop's own login cookie (a JWT, as in L8's jwt-walkthrough).
# Create it with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TOKEN_SECRET=


# GitHub: Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL: http://localhost:5173
#   Redirect URI: http://localhost:5173/api/auth/github/callback (must match GITHUB_CALLBACK_URL exactly)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# GitHub usernames that are admins, exactly as on GitHub, comma-separated without spaces, e.g. anna-k,erik99
# OBS, make sure to add "sibala" to the allowed admins list
ADMIN_GITHUB_LOGINS=


# Resend → https://resend.com
#   1. Create an account – the free plan is enough (100 e-mails per day)
#   2. API Keys → Create API Key → Permission "Sending access"
#   3. Copy the key at once – it is only shown when it is created
RESEND_API_KEY=

# The sender – choose ONE of the two:
#
# A. Resend's free test address – no domain needed (enough for Labb 8)
#      EMAIL_FROM=The Shop <onboarding@resend.dev>
#    It can ONLY send to the e-mail address of your Resend account.
#    Any other address → Resend answers 403 "You can only send testing emails to your own email address".
#
# B. Your own domain – send to anyone
#   1. Resend → Domains → Add Domain → a subdomain, e.g. mail.your-domain.se
#      (a subdomain keeps the shop's e-mail apart from your ordinary e-mail on the domain)
#   2. Add the DNS records Resend shows, where your domain's DNS is (Loopia, One.com, Cloudflare …):
#        - DKIM: a TXT record, resend._domainkey.mail
#        - SPF:  an MX record and a TXT record, send.mail
#      Copy name and value exactly. Many DNS editors add .your-domain.se to the name themselves –
#      then type only the part before it.
#   3. Resend → Verify. Usually a few minutes, sometimes a few hours, until the status is "Verified".
#      Stuck on "Pending"? Check the records, and that the domain's DNSSEC works:
#        dig NS your-domain.se @8.8.8.8   → SERVFAIL = DNSSEC is broken, contact your DNS provider
#   4. Any address on the verified domain works – no real inbox needed:
#      EMAIL_FROM=Min e-handel <order@mail.your-domain.se>
#   Free plan: one domain, 100 e-mails per day.
EMAIL_FROM=Min e-handel <onboarding@resend.dev>
